# when I need help, so, I have markdown guides
alias s='glow -p ~/help/chuletilla-systemctl.md'

# programs
alias v='nvim'

# screen gamma
alias fl='xrandr --output DP-0 --gamma 1.8:1.8:1.8'
alias nofl='xrandr --output DP-0 --gamma 1.0:1.0:1.0'

# dwm 
alias cdwm='nvim ~/.suckless/dwm/config.h'
alias mdwm='cd ~/.suckless/dwm; sudo make clean install; cd -'
